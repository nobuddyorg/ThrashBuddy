meta {
  name: start
  type: http
  seq: 2
}

post {
  url: http://{{host}}/api/start
  body: json
  auth: none
}

body:json {
  {
    "cpu": "512m",
    "memory": "1024Mi",
    "loadAgents": 5,
    "envVars": []
  }
}

tests {
  test("status is 200 or 400", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400]);
  });
  test("response has a status field", function () {
    expect(res.getBody()).to.have.property("status");
  });
}
